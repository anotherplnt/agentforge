# AgentForge Environment Variables
# Copy this to .env.local and fill in your values

# Contract address (deployed on Arc Testnet)
NEXT_PUBLIC_AGENTFORGE_ADDRESS=0x0000000000000000000000000000000000000000

# Arc Testnet RPC
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# Private key for server-side transactions (DO NOT COMMIT)
PRIVATE_KEY=

# OpenAI API key for agent inference
OPENAI_API_KEY=

# Optional: Circle Developer API
CIRCLE_API_KEY=
