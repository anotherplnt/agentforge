# Copy to .env.local and fill in.

# AgentForge marketplace contract on Arc testnet.
# Leave as the zero address to fall back to the registries in src/lib/config.ts.
NEXT_PUBLIC_AGENTFORGE_ADDRESS=0x0000000000000000000000000000000000000000

# Arc testnet RPC.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# Server-side signer for relayed transactions. Never commit a real key.
PRIVATE_KEY=

# Agent inference backend (optional).
OPENAI_API_KEY=

# Circle developer API (optional).
CIRCLE_API_KEY=
